APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# 儲存基準時區＝台北（見 docs/common/10028）。config 預設已是 Asia/Taipei，此處明寫。
APP_TIMEZONE=Asia/Taipei

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Portal 閘道設定 ──
# api_key: 應用層閘道（X-API-KEY），驗證請求來自我方授權的 App
# dev_key: Dev Impersonation 專用（X-DEV-KEY），僅非 production 環境有效
OCADMIN_API_KEY=
OCADMIN_DEV_KEY=
API_API_KEY=
API_DEV_KEY=

# Per-Portal IP 限制（白名單存於 settings 資料表）
OCADMIN_IP_RESTRICT=false
API_IP_RESTRICT=false

# ── Portal 認證設定 ──
# 認證 driver：sanctum（預設，帳密 + session） / oauth（OAuth 2.0，需先在 OauthAuthDriver 落地實作）
# 對應實作見 app/Portals/Ocadmin/Core/Drivers/Auth/
OCADMIN_AUTH_DRIVER=sanctum

# ── 選單來源 ──
# code（預設，hardcoded 在 MenuComposer，clone 即跑、零 DB 依賴）
# database（從 sys_menus 表讀取，需先跑 db:seed；適合 runtime 後台編輯選單的場景）
# 詳：docs/common/10011_選單機制.md
# MENU_DRIVER=code

# ── DevLogin 短路登入（僅 APP_ENV=local） ──
# CLI / 自動化測試 / AI Agent 用：POST /dev/login + email + token → Auth::login
# 留空 = 機制關閉（路由根本不註冊）。詳：docs/common/10027_DevLogin開發登入繞過機制.md
# 產生 token：openssl rand -hex 32  或  php -r "echo bin2hex(random_bytes(32));"
DEV_LOGIN_TOKEN=
